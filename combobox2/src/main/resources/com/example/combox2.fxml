<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.Controller">

    <children>

        <Label layoutX="10.0"
               layoutY="10.0"
               prefWidth="680.0"
               wrapText="true"
               style="-fx-background-color: cyan;"
               text="RGB7171 - Орц, давхар, хаалга. Байшингийн давхар, орц, нэг давхарт суудаг айлын тоо мэдэгдэж байвал энэхүү байшингийн өгөгдсөн тоот нь хэддүгээр орцны, хэдэн давхрын хэд дэх хаалга болохыг ол.">

            <padding>
                <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
            </padding>

            <font>
                <Font size="14.0"/>
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="120.0" text="Давхарын тоо:"/>
        <ComboBox fx:id="cmbFloorCount"
                  layoutX="250.0"
                  layoutY="115.0"
                  prefWidth="150.0"/>

        <Label layoutX="30.0" layoutY="180.0" text="Орцны тоо:"/>
        <ComboBox fx:id="cmbApartment"
                  layoutX="250.0"
                  layoutY="175.0"
                  prefWidth="150.0"/>

        <Label layoutX="30.0" layoutY="240.0" text="Нэг давхрын хаалганы тоо:"/>
        <ComboBox fx:id="cmbDoorCount"
                  layoutX="250.0"
                  layoutY="235.0"
                  prefWidth="150.0"/>

        <Label layoutX="30.0" layoutY="300.0" text="Айлын дугаар:"/>
        <TextField fx:id="txtDoorNumber"
                   layoutX="250.0"
                   layoutY="295.0"
                   prefWidth="150.0"/>

        <Button layoutX="250.0"
                layoutY="350.0"
                prefWidth="120.0"
                text="Бодох"
                onAction="#buttonclick"/>

        <Label fx:id="lblResult"
               layoutX="30.0"
               layoutY="420.0"
               prefWidth="600.0">

            <font>
                <Font size="18.0"/>
            </font>
        </Label>

    </children>

</AnchorPane>